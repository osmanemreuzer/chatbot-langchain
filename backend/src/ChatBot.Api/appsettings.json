{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ChatBotDb": "REPLACE_WITH_CONNECTION_STRING"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_JWT_SECRET",
    "Issuer": "ChatBotApi",
    "Audience": "ChatBotClient",
    "ExpiryMinutes": 60
  },
  "AIService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Storage": {
    "UploadPath": "App_Data/documents"
  }
}